<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationId>com.novolis.sudoku</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(NovolisAndroidVersionCode)' != ''">$(NovolisAndroidVersionCode)</ApplicationVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <RootNamespace>Sudoku.Android</RootNamespace>
    <AssemblyName>Novolis.Sudoku.Android</AssemblyName>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidFastDeployment Condition="'$(Configuration)' == 'Release'">false</AndroidFastDeployment>
    <EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Release'">true</EmbedAssembliesIntoApk>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">false</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sudoku.App\Sudoku.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
    <LibraryReference Include="Novolis.Avalonia.GraphicalProfile" />
    <LibraryReference Include="Novolis.IO.Platform.Android" />
  </ItemGroup>
</Project>
