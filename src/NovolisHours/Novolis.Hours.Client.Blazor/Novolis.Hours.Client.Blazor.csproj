<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Novolis.Hours.Client.Blazor</RootNamespace>
    <AssemblyName>Novolis.Hours.Client.Blazor</AssemblyName>
    <Description>Standalone Blazor WebAssembly client for Novolis Hours.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Hours.Client\Novolis.Hours.Client.csproj" />
  </ItemGroup>
</Project>
