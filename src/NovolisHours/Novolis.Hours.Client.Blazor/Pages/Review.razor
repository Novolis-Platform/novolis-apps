@page "/reviews/{PeriodId:guid}"
@inject HoursBrowserSession Session

<PageTitle>Review period</PageTitle>

@if (Session.ApiClient is null)
{
    <section class="card"><p role="alert">Sign in before opening a review.</p><a href="/">Return to sign in</a></section>
}
else if (month is null && string.IsNullOrWhiteSpace(error))
{
    <section class="card"><p>Loading review…</p></section>
}
else if (month is not null)
{
    <section class="card">
        <p class="eyebrow">@month.WorkplaceName</p>
        <h1>@HoursClock.FormatDate(month.Review.From) – @HoursClock.FormatDate(month.Review.Through)</h1>
        <p>@(month.Review.State == "Approved" ? "Approved" : month.Review.State == "Open" ? "Waiting" : month.Review.State)</p>
        <p>@month.GapLabel</p>
        @if (!string.IsNullOrWhiteSpace(month.ChangedLabel))
        {
            <p class="muted">@month.ChangedLabel</p>
        }
        <div class="summary-grid">
            <div><span class="muted">Usual</span><strong>@HoursClock.Format(month.ExpectedWork)</strong></div>
            <div><span class="muted">Recorded</span><strong>@HoursClock.Format(month.ActualWork)</strong></div>
        </div>
        <div class="week-grid">
            @foreach (var day in month.Days)
            {
                var chip = WeekStudioModel.ChipFor(day);
                <a class="week-tile @(chip == "Changed" ? "changed" : null) @(chip == "Closed" ? "shut" : null) @(chip == "Not recorded" ? "gap" : null)"
                   href="/workdays/@day.EmployeeId/@day.NominalDate.ToString("yyyy-MM-dd")">
                    <span class="week-when">
                        <strong>@HoursClock.FormatDate(day.NominalDate).Split(' ')[0]</strong>
                        <span class="muted">@HoursClock.FormatDayMonth(day.NominalDate)</span>
                    </span>
                    <span>@chip</span>
                    <span class="muted week-detail">@WeekStudioModel.DetailFor(day)</span>
                </a>
            }
        </div>
        @if (month.Review.ChangedAfterApproval)
        {
            <p class="status">Changed after approval: configured review steps are outstanding again.</p>
        }
        @if (Session.CurrentUser is not null && !Session.CurrentUser.Has(HoursClientRole.Auditor))
        {
            <label>Comment <input @bind="actionComment" /></label>
        }
        <div class="toolbar">
            @if (Session.CurrentUser is not null &&
                Session.CurrentUser.Has(HoursClientRole.Employee) &&
                Session.CurrentUser.EmployeeId == month.Review.EmployeeId &&
                (month.HasSubmitStage || month.HasAcknowledgeStage))
            {
                <button class="action" @onclick="() => RecordAsync(month.EmployeePrimaryAction)">@month.EmployeePrimaryLabel</button>
                @if (month.HasAcknowledgeStage && month.HasSubmitStage)
                {
                    <button @onclick='() => RecordAsync("Acknowledge")'>Acknowledge</button>
                }
                @if (month.AllowsDispute)
                {
                    <button @onclick='() => RecordAsync("Dispute")'>Dispute</button>
                }
            }
            @if (month.HasApproveStage &&
                Session.CurrentUser is not null &&
                (Session.CurrentUser.Has(HoursClientRole.Manager) ||
                 Session.CurrentUser.Has(HoursClientRole.HumanResources) ||
                 Session.CurrentUser.Has(HoursClientRole.Higher) ||
                 Session.CurrentUser.Has(HoursClientRole.Administrator)))
            {
                <button class="action" @onclick='() => RecordAsync("Approve")'>Approve</button>
            }
            @if (month.AllowsDispute &&
                Session.CurrentUser is not null &&
                (Session.CurrentUser.Has(HoursClientRole.HumanResources) ||
                 Session.CurrentUser.Has(HoursClientRole.Higher) ||
                 Session.CurrentUser.Has(HoursClientRole.Administrator)))
            {
                <button @onclick='() => RecordAsync("Resolve")'>Resolve</button>
            }
        </div>
    </section>

    <section class="card">
        <h2>Who still needs to act</h2>
        <div class="toolbar">
            @foreach (var stage in month.Review.Stages)
            {
                <span class="week-tile @(stage.IsComplete ? "open" : null)">
                    @ReviewMonthModel.StageActorLabel(stage)
                    · @ReviewMonthModel.StageStateLabel(stage)
                </span>
            }
        </div>
    </section>

    <section class="card">
        <h2>Action history</h2>
        @if (month.Review.Actions.Length == 0)
        {
            <p>No actions have been appended.</p>
        }
        else
        {
            <ol>
                @foreach (var action in month.Review.Actions)
                {
                    <li>@action.RecordedAt · @action.Kind · @action.ActorId (@action.ActorRole) @action.Comment</li>
                }
            </ol>
        }
    </section>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <p class="status" role="alert">@error</p>
}

@code {
    [Parameter]
    public Guid PeriodId { get; set; }

    private ReviewMonthModel? month;
    private string error = string.Empty;
    private string actionComment = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        month = null;
        error = string.Empty;
        await Session.RestoreAsync();
        if (Session.ApiClient is null)
        {
            return;
        }

        try
        {
            var projection = await Session.ApiClient.GetReviewAsync(PeriodId);
            var days = await Session.ApiClient.GetWorkDaysAsync(
                projection.EmployeeId,
                projection.From,
                projection.Through);
            month = new ReviewMonthModel(projection, days);
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
    }

    private async Task RecordAsync(string kind)
    {
        if (Session.ApiClient is null || month is null)
        {
            return;
        }

        try
        {
            await Session.ApiClient.RecordReviewActionAsync(
                PeriodId,
                new RecordReviewActionRequest(
                    kind,
                    null,
                    string.IsNullOrWhiteSpace(actionComment) ? null : actionComment,
                    month.Review.JournalHead));
            var projection = await Session.ApiClient.GetReviewAsync(PeriodId);
            var days = await Session.ApiClient.GetWorkDaysAsync(
                projection.EmployeeId,
                projection.From,
                projection.Through);
            month = new ReviewMonthModel(projection, days);
            actionComment = string.Empty;
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
    }
}
