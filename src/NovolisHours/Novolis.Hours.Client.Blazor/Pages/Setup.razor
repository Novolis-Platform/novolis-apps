@page "/setup"
@inject HoursBrowserSession Session
@inject NavigationManager Navigation

<PageTitle>Open a customer</PageTitle>

@if (Session.CurrentUser?.Role == HoursClientRole.Administrator)
{
    <section class="card">
        <p class="eyebrow">Workplace</p>
        <h1>Rules belong to the customer</h1>
        <p class="muted">The platform already opened this customer. Set the week, flex, and how months close on Rules.</p>
        <a class="action-link" href="rules">Open rules</a>
    </section>
}
else if (Session.CurrentUser?.Role != HoursClientRole.System)
{
    <section class="card">
        <p class="eyebrow">Setup</p>
        <h1>Platform only</h1>
        <p class="muted">The platform opens a customer. The customer administrator then sets the rules and hires people.</p>
    </section>
}
else if (model is null)
{
    <p class="muted">Loading locations…</p>
}
else if (model.Created is not null)
{
    <section class="card">
        <p class="eyebrow">Customer is open</p>
        <h1>@model.Created.DisplayName</h1>
        <p>@model.Created.Id · @model.Created.CountryCode · @model.Created.TimeZoneId</p>
        <p>Administrator: <strong>@model.Admin?.DisplayName</strong> · @model.Admin?.Login</p>
        @if (model.AdminAlsoHr)
        {
            <p>This administrator also closes months as HR. They can hire a separate HR person later if they want.</p>
        }
        else
        {
            <p>The administrator signs in next, sets the rules, then hires people. They may also act as HR.</p>
        }
        <a class="action-link" href="/">Back to backoffice</a>
    </section>
}
else
{
    <section class="card">
        <p class="eyebrow">Platform</p>
        <h1>Open a customer</h1>
        <p class="muted">Location sets the public calendar. Name is the customer. The first user is that customer’s administrator.</p>
    </section>

    <section class="card">
        <h2>Location</h2>
        <p class="muted">This is the baseline calendar and time zone. It is not a product pattern.</p>
        <div class="form-grid">
            @foreach (var location in model.Locations)
            {
                <button type="button"
                        class="template-card @(location.Id == model.SelectedLocationId ? "open" : null)"
                        @onclick="() => model.SelectedLocationId = location.Id">
                    <strong>@location.Title</strong>
                    <span class="muted">@location.CalendarSummary</span>
                </button>
            }
        </div>
    </section>

    <section class="card">
        <h2>Customer</h2>
        <div class="form-grid">
            <label>Customer name
                <input @bind="model.DisplayName" autocomplete="organization" />
            </label>
            <label>Organisation id
                <input @bind="model.OrganisationId" autocomplete="off" placeholder="@CustomerOpenModel.Slug(model.DisplayName)" />
            </label>
        </div>
    </section>

    <section class="card">
        <h2>Administrator</h2>
        <p class="muted">This person receives the customer. They set the rules. They may also be HR.</p>
        <div class="form-grid">
            <label>Administrator name
                <input @bind="model.AdminDisplayName" autocomplete="name" />
            </label>
            <label>Login
                <input @bind="model.AdminLogin" autocomplete="username" />
            </label>
            <label>Employee id
                <input @bind="model.AdminEmployeeId" autocomplete="off" />
            </label>
            <label>Password
                <input @bind="model.AdminPassword" type="password" autocomplete="new-password" />
            </label>
        </div>
        <label>
            <input type="checkbox" @bind="model.AdminAlsoHr" />
            Administrator is also HR
        </label>
        <label>
            <input type="checkbox" @bind="model.AdminAlsoEmployee" />
            Administrator also records hours
        </label>
        <button class="action" @onclick="OpenCustomerAsync" disabled="@(busy || !model.CanOpen)">
            @(busy ? "Opening…" : "Open customer")
        </button>
    </section>
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <p class="status" role="status">@status</p>
}

@code {
    private CustomerOpenModel? model;
    private string status = string.Empty;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        if (Session.CurrentUser?.Role != HoursClientRole.System || Session.ApiClient is null)
        {
            return;
        }

        model = new CustomerOpenModel(await Session.ApiClient.ListLocationsAsync());
    }

    private async Task OpenCustomerAsync()
    {
        if (model is null || Session.ApiClient is null)
        {
            return;
        }

        busy = true;
        status = string.Empty;
        try
        {
            model.Created = await Session.ApiClient.CreateCustomerAsync(new CreateCustomerRequest(
                model.ResolvedOrganisationId,
                model.DisplayName.Trim(),
                TemplateId: null,
                model.SelectedLocationId));
            var extras = new List<HoursClientRole>();
            if (model.AdminAlsoHr)
            {
                extras.Add(HoursClientRole.HumanResources);
            }

            if (model.AdminAlsoEmployee)
            {
                extras.Add(HoursClientRole.Employee);
            }

            model.Admin = await Session.ApiClient.CreateUserAsync(new CreateUserRequest(
                model.ResolvedAdminEmployeeId,
                model.ResolvedAdminLogin,
                model.AdminPassword,
                model.ResolvedAdminDisplayName,
                HoursClientRole.Administrator,
                model.Created.Id,
                model.DivisionId,
                model.TeamId,
                ExtraRoles: extras));
        }
        catch (Exception exception)
        {
            status = exception.Message;
            model.Created = null;
            model.Admin = null;
        }
        finally
        {
            busy = false;
        }
    }
}
