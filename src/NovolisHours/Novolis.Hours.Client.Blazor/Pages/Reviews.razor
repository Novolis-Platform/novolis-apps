@page "/reviews"
@inject HoursBrowserSession Session

<PageTitle>Reviews</PageTitle>

<header class="hero">
    <p class="eyebrow">Workplace</p>
    <h1>Reviews</h1>
    <p>Months waiting for you. Open one, read the gaps, then approve.</p>
</header>

@if (Session.CurrentUser is null || Session.ApiClient is null)
{
    <section class="card">
        <p role="alert">Sign in before opening reviews.</p>
        <a href="/">Return to sign in</a>
    </section>
}
else if (items is null)
{
    <section class="card"><p>Loading reviews…</p></section>
}
else if (items.Count == 0)
{
    <section class="card">
        <p>No review periods have been opened on this workplace.</p>
    </section>
}
else
{
    <section class="card">
        <ul>
            @foreach (var item in items)
            {
                <li>
                    <a class="action-link" href="/reviews/@item.PeriodId.ToString("D")">
                        @item.EmployeeId · @HoursClock.FormatDayMonth(item.From) – @HoursClock.FormatDayMonth(item.Through)
                    </a>
                    <p class="muted">@(item.State == "Approved" ? "Approved" : "Waiting")</p>
                </li>
            }
        </ul>
    </section>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <p class="status" role="alert">@error</p>
}

@code {
    private IReadOnlyList<ReviewInboxItemResponse>? items;
    private string error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        if (Session.ApiClient is null)
        {
            return;
        }

        try
        {
            items = await Session.ApiClient.ListReviewsAsync();
        }
        catch (Exception exception)
        {
            error = exception.Message;
            items = [];
        }
    }
}
