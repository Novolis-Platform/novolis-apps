@page "/"
@inject HoursBrowserSession Session
@inject NavigationManager Navigation

<PageTitle>Novolis Hours</PageTitle>

@if (Session.CurrentUser is null)
{
    <section class="card">
        <p class="eyebrow">Sign in</p>
        <h1>Hours</h1>
        <p class="muted">Sign in to record your hours, set the workplace, or close a month.</p>
        <div class="form-grid">
            <label>Login <input @bind="login" autocomplete="username" /></label>
            <label>Password <input @bind="password" type="password" autocomplete="current-password" /></label>
        </div>
        <details>
            <summary class="muted">Host settings</summary>
            <label>Hours service URL <input @bind="serviceUrl" type="url" autocomplete="url" /></label>
        </details>
        <button class="action" @onclick="SignInAsync" disabled="@busy">@(busy ? "Signing in…" : "Sign in")</button>
    </section>
}
else if (surface == HoursSurfaceKind.Backoffice)
{
    <section class="card">
        <p class="eyebrow">Platform</p>
        <h1>Backoffice</h1>
        <p>Customers, not a timesheet. Open a customer with a location, a name, and an administrator, then leave.</p>
        <a class="action-link" href="setup">Open a customer</a>
    </section>
    <section class="card">
        <h2>Customers</h2>
        @if (customers is null)
        {
            <p class="muted">Loading customers…</p>
        }
        else if (customers.Count == 0)
        {
            <p>No customers have been provisioned.</p>
        }
        else
        {
            <ul>
                @foreach (var customer in customers)
                {
                    <li>
                        <strong>@customer.DisplayName</strong>
                        <span class="muted"> · @customer.Id · @customer.CountryCode · @customer.TimeZoneId</span>
                    </li>
                }
            </ul>
        }
    </section>
}
else if (week is not null || month is not null)
{
    <section class="card">
        <div class="toolbar">
            <div>
                <p class="eyebrow">@(showMonth ? "This month" : "This week")</p>
                <h1>@(showMonth && month is not null
                    ? month.Title
                    : week is not null
                        ? $"{HoursClock.FormatDate(week.WeekStart)} – {HoursClock.FormatDate(week.WeekEnd)}"
                        : "Hours")</h1>
                <p>@(showMonth
                    ? "Weeks are numbered. Open a day inside its week."
                    : "Open a day. Say you worked as planned, or enter the hours you actually worked.")</p>
            </div>
            <div class="toolbar">
                <button type="button" class="@(showMonth ? null : "action")" @onclick="ShowWeekAsync">This week</button>
                <button type="button" class="@(showMonth ? "action" : null)" @onclick="ShowMonthAsync">This month</button>
                <button @onclick="() => ShiftAsync(-1)">Previous</button>
                <button @onclick="GoTodayAsync">Today</button>
                <button @onclick="() => ShiftAsync(1)">Next</button>
            </div>
        </div>
        @if (showMonth && month is not null)
        {
            <div class="month-grid" role="grid" aria-label="@month.Title">
                <span class="month-week-number muted">Wk</span>
                <span class="muted">Mon</span><span class="muted">Tue</span><span class="muted">Wed</span>
                <span class="muted">Thu</span><span class="muted">Fri</span><span class="muted">Sat</span>
                <span class="muted">Sun</span>
                @foreach (var row in month.Weeks)
                {
                    <span class="month-week-number">@row.NumberLabel</span>
                    @foreach (var day in row.Days)
                    {
                        if (day.Day is null)
                        {
                            <span class="month-day @(day.InMonth ? null : "outside")"></span>
                        }
                        else
                        {
                            <a class="month-day @(day.IsToday ? "open" : null) @(day.Chip == "Changed" ? "changed" : null) @(day.Chip == "Closed" ? "shut" : null) @(day.Chip == "Not recorded" && day.InMonth ? "gap" : null) @(day.InMonth ? null : "outside")"
                               href="@DayUrl(day.Date)"
                               aria-label="@HoursClock.FormatDate(day.Date), week @row.WeekNumber, @day.Chip">
                                <strong>@day.Date.Day</strong>
                                <span>@day.Chip</span>
                            </a>
                        }
                    }
                }
            </div>
            <p>@month.GapLabel</p>
            @if (!string.IsNullOrWhiteSpace(month.ChangedLabel))
            {
                <p class="muted">@month.ChangedLabel</p>
            }
        }
        else if (week is not null)
        {
            <div class="week-grid">
                @foreach (var tile in week.Tiles)
                {
                    <a @key="tile.Date"
                       class="week-tile @(tile.IsToday ? "open" : null) @(tile.Chip == "Changed" ? "changed" : null) @(tile.Chip == "Closed" ? "shut" : null) @(tile.Chip == "Not recorded" ? "gap" : null)"
                       href="@DayUrl(tile.Date)"
                       aria-label="@HoursClock.FormatDate(tile.Date), @tile.Chip, @tile.Detail">
                        <span class="week-when">
                            <strong>@tile.Weekday</strong>
                            <span class="muted">@HoursClock.FormatDayMonth(tile.Date)</span>
                        </span>
                        <span>@tile.Chip</span>
                        <span class="muted week-detail">@tile.Detail</span>
                    </a>
                }
            </div>
            <p>@week.GapLabel</p>
            @if (!string.IsNullOrWhiteSpace(week.ChangedLabel))
            {
                <p class="muted">@week.ChangedLabel</p>
            }
            <div class="summary-grid">
                <div><span class="muted">Usual this week</span><strong>@HoursClock.Format(week.ExpectedWork)</strong></div>
                <div><span class="muted">Recorded</span><strong>@HoursClock.Format(week.RecordedWork)</strong></div>
            </div>
        }
        @if (Session.CurrentUser.Has(HoursClientRole.Employee))
        {
            <div class="toolbar">
                <button class="action" @onclick="OpenMonthReviewAsync" disabled="@busy">Hand month to HR</button>
            </div>
        }
    </section>
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <p class="status" role="status">@status</p>
}

@code {
    private string serviceUrl = "https://localhost:5700/";
    private string login = string.Empty;
    private string password = string.Empty;
    private string status = string.Empty;
    private bool busy;
    private WeekStudioModel? week;
    private HoursMonthModel? month;
    private bool showMonth;
    private DateOnly weekStart = WeekStudioModel.MondayOnOrBefore(DateOnly.FromDateTime(DateTime.Today));
    private DateOnly monthCursor = new(DateOnly.FromDateTime(DateTime.Today).Year, DateOnly.FromDateTime(DateTime.Today).Month, 1);
    private HoursSurfaceKind? surface;
    private IReadOnlyList<HoursCustomerResponse>? customers;

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        serviceUrl = Session.ServiceUrl;
        if (Session.CurrentUser is not null)
        {
            login = Session.CurrentUser.EmployeeId;
            await ArriveAsync();
        }
    }

    private string DayUrl(DateOnly date) =>
        $"workdays/{Uri.EscapeDataString(Session.CurrentUser!.EmployeeId)}/{date:yyyy-MM-dd}";

    private async Task SignInAsync()
    {
        busy = true;
        status = string.Empty;
        try
        {
            Session.ServiceUrl = serviceUrl;
            await Session.SignInAsync(login, password);
            await ArriveAsync();
        }
        catch (Exception exception)
        {
            status = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ArriveAsync()
    {
        if (Session.CurrentUser is null)
        {
            return;
        }

        var roles = Session.CurrentUser.AssignedRoles;
        var home = HoursRoleSurface.Home(roles);
        var path = HoursRoleSurface.HomePath(roles);
        if (path != "/")
        {
            Navigation.NavigateTo(path);
            return;
        }

        surface = home;
        if (home == HoursSurfaceKind.Backoffice)
        {
            await LoadBackofficeAsync();
            return;
        }

        await LoadTimesheetAsync();
    }

    private async Task LoadBackofficeAsync()
    {
        if (Session.ApiClient is null)
        {
            return;
        }

        var all = await Session.ApiClient.ListCustomersAsync();
        customers = all
            .Where(customer => !string.Equals(customer.Id, "hours-platform", StringComparison.Ordinal))
            .ToArray();
    }

    private async Task ShowWeekAsync()
    {
        showMonth = false;
        await LoadTimesheetAsync();
    }

    private async Task ShowMonthAsync()
    {
        showMonth = true;
        await LoadTimesheetAsync();
    }

    private async Task ShiftAsync(int steps)
    {
        if (showMonth)
        {
            monthCursor = monthCursor.AddMonths(steps);
        }
        else
        {
            weekStart = weekStart.AddDays(steps * 7);
        }

        await LoadTimesheetAsync();
    }

    private async Task GoTodayAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        weekStart = WeekStudioModel.MondayOnOrBefore(today);
        monthCursor = new DateOnly(today.Year, today.Month, 1);
        await LoadTimesheetAsync();
    }

    private async Task OpenMonthReviewAsync()
    {
        if (Session.ApiClient is null || Session.CurrentUser is null)
        {
            return;
        }

        busy = true;
        status = string.Empty;
        try
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            var monthStart = new DateOnly(today.Year, today.Month, 1);
            var monthEnd = monthStart.AddMonths(1).AddDays(-1);
            var periodId = await Session.ApiClient.CreateReviewPeriodAsync(new CreateReviewPeriodRequest(
                Session.CurrentUser.EmployeeId,
                monthStart,
                monthEnd));
            Navigation.NavigateTo($"/reviews/{periodId:D}");
        }
        catch (Exception exception)
        {
            status = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadTimesheetAsync()
    {
        if (Session.ApiClient is null || Session.CurrentUser is null)
        {
            return;
        }

        var today = DateOnly.FromDateTime(DateTime.Today);
        var weekDays = await Session.ApiClient.GetWorkDaysAsync(
            Session.CurrentUser.EmployeeId,
            weekStart,
            weekStart.AddDays(6));
        week = new WeekStudioModel(weekDays, today);
        var monthDays = await Session.ApiClient.GetWorkDaysAsync(
            Session.CurrentUser.EmployeeId,
            monthCursor,
            monthCursor.AddMonths(1).AddDays(-1));
        month = new HoursMonthModel(monthCursor.Year, monthCursor.Month, monthDays, today);
    }
}
