@page "/"
@inject HoursBrowserSession Session
@inject NavigationManager Navigation

<PageTitle>Novolis Hours</PageTitle>

@if (Session.CurrentUser is null)
{
    <section class="card">
        <p class="eyebrow">Sign in</p>
        <h1>Hours</h1>
        <div class="form-grid">
            <label>Login <input @bind="login" autocomplete="username" /></label>
            <label>Password <input @bind="password" type="password" autocomplete="current-password" /></label>
        </div>
        <details>
            <summary class="muted">Host settings</summary>
            <label>Hours service URL <input @bind="serviceUrl" type="url" autocomplete="url" /></label>
        </details>
        <button class="action" @onclick="SignInAsync" disabled="@busy">@(busy ? "Signing in…" : "Enter this week")</button>
    </section>
}
else if (week is not null)
{
    <section class="card">
        <div class="toolbar">
            <div>
                <p class="eyebrow">Week</p>
                <h1>@HoursClock.FormatDate(week.WeekStart) – @HoursClock.FormatDate(week.WeekEnd)</h1>
            </div>
            <div class="toolbar">
                <button @onclick="() => ShiftWeek(-7)">Previous</button>
                <button @onclick="GoToday">Today</button>
                <button @onclick="() => ShiftWeek(7)">Next</button>
                <button @onclick="SignOutAsync" disabled="@busy">Sign out</button>
            </div>
        </div>
        <div class="week-grid">
            @foreach (var tile in week.Tiles)
            {
                <a class="week-tile @(tile.IsToday ? "open" : null)" href="@DayUrl(tile.Date)">
                    <span class="muted">@tile.Weekday</span>
                    <strong>@tile.Expected</strong>
                    <span class="muted">@tile.Chip</span>
                </a>
            }
        </div>
        <div class="summary-grid">
            <div><span class="muted">Expected</span><strong>@HoursClock.Format(week.ExpectedWork)</strong></div>
            <div><span class="muted">Recorded</span><strong>@HoursClock.Format(week.RecordedWork)</strong></div>
        </div>
    </section>
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <p class="status" role="status">@status</p>
}

@code {
    private string serviceUrl = "https://localhost:5700/";
    private string login = string.Empty;
    private string password = string.Empty;
    private string status = string.Empty;
    private bool busy;
    private WeekStudioModel? week;
    private DateOnly weekStart = WeekStudioModel.MondayOnOrBefore(DateOnly.FromDateTime(DateTime.Today));

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        serviceUrl = Session.ServiceUrl;
        if (Session.CurrentUser is not null)
        {
            login = Session.CurrentUser.EmployeeId;
            await LoadWeekAsync();
        }
    }

    private string DayUrl(DateOnly date) =>
        $"workdays/{Uri.EscapeDataString(Session.CurrentUser!.EmployeeId)}/{date:yyyy-MM-dd}";

    private async Task SignInAsync()
    {
        busy = true;
        status = string.Empty;
        try
        {
            Session.ServiceUrl = serviceUrl;
            await Session.SignInAsync(login, password);
            await LoadWeekAsync();
        }
        catch (Exception exception)
        {
            status = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SignOutAsync()
    {
        busy = true;
        try
        {
            await Session.SignOutAsync();
            week = null;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ShiftWeek(int days)
    {
        weekStart = weekStart.AddDays(days);
        await LoadWeekAsync();
    }

    private async Task GoToday()
    {
        weekStart = WeekStudioModel.MondayOnOrBefore(DateOnly.FromDateTime(DateTime.Today));
        await LoadWeekAsync();
    }

    private async Task LoadWeekAsync()
    {
        if (Session.ApiClient is null || Session.CurrentUser is null)
        {
            return;
        }

        var days = await Session.ApiClient.GetWorkDaysAsync(
            Session.CurrentUser.EmployeeId,
            weekStart,
            weekStart.AddDays(6));
        week = new WeekStudioModel(days, DateOnly.FromDateTime(DateTime.Today));
    }
}
