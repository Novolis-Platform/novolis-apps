@inherits LayoutComponentBase
@implements IDisposable
@inject HoursBrowserSession Session
@inject NavigationManager Navigation

<div class="page-shell">
    <header class="chrome">
        <span class="wordmark">Hours</span>
        @if (Session.CurrentUser is not null)
        {
            <span>@Session.CurrentUser.DisplayName</span>
            <span class="muted">@chromeLine</span>
            <nav class="toolbar" aria-label="@navLabel">
                @foreach (var link in links)
                {
                    <a href="@link.Href">@link.Label</a>
                }
                <button type="button" @onclick="SignOutAsync">Sign out</button>
            </nav>
        }
    </header>
    @Body
</div>

@code {
    private string chromeLine = string.Empty;
    private string navLabel = "Hours navigation";
    private readonly List<(string Href, string Label)> links = [];

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        await Session.RestoreAsync();
        await RefreshChromeAsync();
    }

    private void OnSessionChanged() =>
        _ = InvokeAsync(async () =>
        {
            await RefreshChromeAsync();
            StateHasChanged();
        });

    private async Task RefreshChromeAsync()
    {
        links.Clear();
        chromeLine = string.Empty;
        navLabel = "Hours navigation";
        if (Session.CurrentUser is null)
        {
            return;
        }

        var roles = Session.CurrentUser.AssignedRoles;
        var home = HoursRoleSurface.Home(roles);
        chromeLine = HoursClientRoleSet.Label(roles);
        navLabel = home == HoursSurfaceKind.Backoffice ? "Backoffice navigation" : "Hours navigation";

        if (home == HoursSurfaceKind.Backoffice)
        {
            links.Add(("/", "Backoffice"));
            links.Add(("setup", "Setup"));
            return;
        }

        if (HoursRoleSurface.ShowsTimesheet(roles))
        {
            links.Add(("/", "This week"));
            links.Add((TodayUrl, "Today"));
            links.Add(("settings", "My hours"));
        }

        if (HoursRoleSurface.ShowsWorkplace(roles))
        {
            links.Add(("workplace", "Workplace"));
            links.Add(("people", "People"));
            links.Add(("rules", "Rules"));
        }

        if (HoursRoleSurface.ShowsReviews(roles))
        {
            links.Add(("reviews", "Reviews"));
            links.Add(("reports/health", "Health"));
        }

        if (HoursRoleSurface.ShowsAudit(roles))
        {
            links.Add(("audit", "Audit"));
        }

        if (HoursRoleSurface.ShowsTimesheet(roles))
        {
            await FillTimesheetChromeAsync();
            return;
        }

        if (HoursRoleSurface.ShowsWorkplace(roles))
        {
            await FillWorkplaceNameAsync();
        }
    }

    private string TodayUrl =>
        Session.CurrentUser is null
            ? "/"
            : $"workdays/{Uri.EscapeDataString(Session.CurrentUser.EmployeeId)}/{DateOnly.FromDateTime(DateTime.Today):yyyy-MM-dd}";

    private async Task FillWorkplaceNameAsync()
    {
        if (Session.ApiClient is null || Session.CurrentUser is null)
        {
            return;
        }

        try
        {
            var users = await Session.ApiClient.ListUsersAsync();
            var self = users.FirstOrDefault(user =>
                string.Equals(user.EmployeeId, Session.CurrentUser.EmployeeId, StringComparison.OrdinalIgnoreCase));
            if (self is null)
            {
                return;
            }

            var shop = (await Session.ApiClient.ListCustomersAsync())
                .FirstOrDefault(customer =>
                    string.Equals(customer.Id, self.OrganisationId, StringComparison.OrdinalIgnoreCase));
            chromeLine = shop?.DisplayName ?? self.OrganisationId;
        }
        catch
        {
        }
    }

    private async Task FillTimesheetChromeAsync()
    {
        if (Session.ApiClient is null || Session.CurrentUser is null)
        {
            return;
        }

        try
        {
            var start = WeekStudioModel.MondayOnOrBefore(DateOnly.FromDateTime(DateTime.Today));
            var week = await Session.ApiClient.GetWorkDaysAsync(
                Session.CurrentUser.EmployeeId,
                start,
                start.AddDays(6));
            if (week.Count == 0)
            {
                return;
            }

            chromeLine = string.IsNullOrWhiteSpace(week[0].OrganisationName)
                ? week[0].OrganisationId
                : week[0].OrganisationName;
        }
        catch
        {
        }
    }

    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
