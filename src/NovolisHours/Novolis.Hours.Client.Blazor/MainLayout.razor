@inherits LayoutComponentBase
@implements IDisposable
@inject HoursBrowserSession Session
@inject NavigationManager Navigation

<div class="page-shell">
    <header class="chrome">
        <span class="wordmark">Hours</span>
        @if (Session.CurrentUser is not null)
        {
            <span>@Session.CurrentUser.DisplayName</span>
            <span class="muted">@organisation · @timeZone</span>
            @if (showsFlex)
            {
                <span class="muted">Flex @flex</span>
            }
            else if (!string.IsNullOrWhiteSpace(attendance))
            {
                <span class="muted">@attendance</span>
            }
            <nav class="toolbar" aria-label="Hours navigation">
                <a href="/">Week</a>
                <a href="@TodayUrl">Today</a>
                <a href="settings">Settings</a>
                @if (Session.CurrentUser.Role is HoursClientRole.Manager or HoursClientRole.HumanResources or HoursClientRole.Higher or HoursClientRole.Auditor or HoursClientRole.Administrator or HoursClientRole.System)
                {
                    <a href="reports/health">Health</a>
                    <a href="reports/business-pressure">Pressure</a>
                }
            </nav>
        }
    </header>
    @Body
</div>

@code {
    private string organisation = string.Empty;
    private string timeZone = string.Empty;
    private string flex = "0:00";
    private bool showsFlex = true;
    private string attendance = string.Empty;

    private string TodayUrl =>
        Session.CurrentUser is null
            ? "/"
            : $"workdays/{Uri.EscapeDataString(Session.CurrentUser.EmployeeId)}/{DateOnly.FromDateTime(DateTime.Today):yyyy-MM-dd}";

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        await Session.RestoreAsync();
        await RefreshChromeAsync();
    }

    private void OnSessionChanged() =>
        _ = InvokeAsync(async () =>
        {
            await RefreshChromeAsync();
            StateHasChanged();
        });

    private async Task RefreshChromeAsync()
    {
        organisation = string.Empty;
        timeZone = string.Empty;
        flex = "0:00";
        showsFlex = true;
        attendance = string.Empty;
        if (Session.ApiClient is null || Session.CurrentUser is null)
        {
            return;
        }

        try
        {
            var start = WeekStudioModel.MondayOnOrBefore(DateOnly.FromDateTime(DateTime.Today));
            var week = await Session.ApiClient.GetWorkDaysAsync(
                Session.CurrentUser.EmployeeId,
                start,
                start.AddDays(6));
            if (week.Count > 0)
            {
                organisation = string.IsNullOrWhiteSpace(week[0].OrganisationName)
                    ? week[0].OrganisationId
                    : week[0].OrganisationName;
                timeZone = week[0].Configuration.TimeZoneId;
                showsFlex = week[0].AllowsFlex;
                attendance = week[0].AttendanceConfirmationOnly ? "Shop hours" : string.Empty;
            }

            if (showsFlex && Session.CurrentUser.Role != HoursClientRole.System)
            {
                var summary = await Session.ApiClient.GetEmployeeSummaryAsync(Session.CurrentUser.EmployeeId);
                flex = HoursClock.Format(summary.FlexSaldo, signed: true);
            }
        }
        catch
        {
            // Chrome stays signed-in even if the week call is empty.
        }
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
