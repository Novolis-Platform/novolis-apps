<Project Sdk="Aspire.AppHost.Sdk/13.6.0">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <NovolisEnableWindowIcon>false</NovolisEnableWindowIcon>
    <NovolisCopyBrandIcon>false</NovolisCopyBrandIcon>
    <!-- Transitive Novolis analyzers are build-time dependencies, not Aspire resources. -->
    <NoWarn>$(NoWarn);ASPIRE004</NoWarn>
    <UserSecretsId>novolis-hours-apphost-2026</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Hours.Server\Novolis.Hours.Server.csproj" />
    <ProjectReference Include="..\Novolis.Hours.Client.Avalonia\Novolis.Hours.Client.Avalonia.csproj" />
    <ProjectReference Include="..\Novolis.Hours.Client.Maui\Novolis.Hours.Client.Maui.csproj" />
    <ProjectReference Include="..\Novolis.Hours.Client.Blazor\Novolis.Hours.Client.Blazor.csproj" />
    <ProjectReference Include="..\Novolis.Hours.Client.Cli\Novolis.Hours.Client.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
  </ItemGroup>
</Project>
