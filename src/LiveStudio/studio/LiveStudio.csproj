<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Novolis.Audio.Live.Studio</AssemblyName>
    <RootNamespace>LiveStudio</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <LiveStudioHostProject>$(MSBuildThisFileDirectory)..\host\LiveStudio.Host.csproj</LiveStudioHostProject>
    <LiveStudioLauncherProject>$(MSBuildThisFileDirectory)..\launcher\LiveStudio.Launcher.csproj</LiveStudioLauncherProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\shared\LiveStudio.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Novolis.Audio.Live" />
    <PackageReference Include="Novolis.Audio.Live.Protocol" />
    <PackageReference Include="Novolis.Audio.Live.Visuals" />
    <PackageReference Include="Novolis.Audio.MusicTheory" />
    <PackageReference Include="Novolis.Audio.Patterns" />
    <PackageReference Include="Novolis.Avalonia.Live" />
    <PackageReference Include="Novolis.Transports.LocalIpc" />
    <PackageReference Include="Novolis.Avalonia.Packaging.Inno">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="BundleLiveHostOnPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_LiveHostPublishDir>$(PublishDir)host\</_LiveHostPublishDir>
      <_LiveLauncherPublishDir>$(PublishDir)launcher\</_LiveLauncherPublishDir>
      <_LiveBundleProps>Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=$(PublishSingleFile);IncludeNativeLibrariesForSelfExtract=$(IncludeNativeLibrariesForSelfExtract)</_LiveBundleProps>
    </PropertyGroup>
    <MSBuild
      Projects="$(LiveStudioHostProject)"
      Targets="Restore"
      Properties="$(_LiveBundleProps)" />
    <MSBuild
      Projects="$(LiveStudioHostProject)"
      Targets="Publish"
      Properties="$(_LiveBundleProps);PublishDir=$(_LiveHostPublishDir)" />
    <MSBuild
      Projects="$(LiveStudioLauncherProject)"
      Targets="Restore"
      Properties="$(_LiveBundleProps)" />
    <MSBuild
      Projects="$(LiveStudioLauncherProject)"
      Targets="Publish"
      Properties="$(_LiveBundleProps);PublishDir=$(_LiveLauncherPublishDir)" />
    <Message Importance="high" Text="Live Studio: bundled host into $(_LiveHostPublishDir)" />
    <Message Importance="high" Text="Live Studio: bundled launcher into $(_LiveLauncherPublishDir)" />
  </Target>
</Project>
