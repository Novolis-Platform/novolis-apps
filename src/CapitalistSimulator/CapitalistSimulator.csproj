<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CapitalistSimulator</RootNamespace>
    <AssemblyName>CapitalistSimulator</AssemblyName>
    <ApplicationTitle>Capitalist Simulator</ApplicationTitle>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>Capitalism 2 homage — firm/unit supply-chain firm sim (Avalonia + headless).</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CapitalistSimulator.Unit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Spectre.Console" />
    <LibraryReference Include="Novolis.Avalonia.Briefing" />
    <LibraryReference Include="Novolis.Avalonia.Controls" />
    <LibraryReference Include="Novolis.Avalonia.Studio" />
    <LibraryReference Include="Novolis.Storage.Abstractions" />
    <LibraryReference Include="Novolis.Storage.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Novolis.Avalonia.Packaging.Inno">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\*.json" />
  </ItemGroup>
</Project>
