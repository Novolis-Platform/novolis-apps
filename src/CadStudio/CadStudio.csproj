<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CadStudio</RootNamespace>
    <AssemblyName>CadStudio</AssemblyName>
    <ApplicationTitle>Novolis CAD Studio</ApplicationTitle>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>Novolis CAD Studio — 2D/3D CAD drafting, ship authoring, appearance, limited mesh modelling, staging, and lit PNG render. Dual Cad+Scene Agent Surfaces.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CadStudio.Unit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <LibraryReference Include="Novolis.Avalonia.GraphicalProfile" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Novolis.Avalonia.Packaging.Inno">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <LibraryReference Include="Novolis.Avalonia.Cad" />
    <LibraryReference Include="Novolis.Avalonia.Cad.Ship" />
    <LibraryReference Include="Novolis.Avalonia.Ship.Design" />
    <LibraryReference Include="Novolis.Avalonia.Modeling" />
    <LibraryReference Include="Novolis.Cad.Primitives" />
    <LibraryReference Include="Novolis.Cad.SceneBridge" />
    <LibraryReference Include="Novolis.Modeling.Scene" />
    <LibraryReference Include="Novolis.Ship.Design" />
    <LibraryReference Include="Novolis.Agent.Core" />
    <LibraryReference Include="Novolis.Agent.Surface" />
    <LibraryReference Include="Novolis.Avalonia.Agent" />
    <LibraryReference Include="Novolis.Avalonia.Agent.Protocol" />
    <LibraryReference Include="Novolis.Avalonia.Raylib" />
    <LibraryReference Include="Novolis.Avalonia.Studio" />
    <LibraryReference Include="Novolis.Avalonia.Rendering" />
    <LibraryReference Include="Novolis.Commands.Expressions" />
    <LibraryReference Include="Novolis.Math.Geometry" />
    <PackageReference Include="Novolis.Raylib" />
    <LibraryReference Include="Novolis.Raylib.Abstractions" />
    <LibraryReference Include="Novolis.Raylib.Bindings" />
    <LibraryReference Include="Novolis.Raylib.Runtime" />
  </ItemGroup>
</Project>
