<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Novolis.Reach.Host.Server</RootNamespace>
    <AssemblyName>Novolis.Reach.Host.Server</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Reach.Protocol\Reach.Protocol.csproj" />
    <ProjectReference Include="..\Reach.Transport\Reach.Transport.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <LibraryReference Include="Novolis.Transports.Datagrams" />
    <LibraryReference Include="Novolis.Transports.Discovery" />
    <LibraryReference Include="Novolis.Transports.Framing" />
    <LibraryReference Include="Novolis.Transports.LocalIpc" />
    <LibraryReference Include="Novolis.Transports.Quic" />
    <LibraryReference Include="Novolis.Transports.Tcp" />
    <LibraryReference Include="Novolis.Transports.Tailscale" />
    <LibraryReference Include="Novolis.Transports.Udp" />
    <LibraryReference Include="Novolis.Windows.Sessions" />
  </ItemGroup>
</Project>
