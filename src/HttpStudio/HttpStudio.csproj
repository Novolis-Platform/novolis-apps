<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>HttpStudio</RootNamespace>
    <AssemblyName>Novolis.HttpStudio</AssemblyName>
    <ApplicationTitle>HTTP Studio</ApplicationTitle>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <LibraryReference Include="Novolis.Avalonia.GraphicalProfile" />
    <LibraryReference Include="Novolis.Http.Client" />
    <LibraryReference Include="Novolis.Http.Documents" />
    <LibraryReference Include="Novolis.Http.Variables" />
  </ItemGroup>
</Project>
