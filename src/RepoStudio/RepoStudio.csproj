<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>RepoStudio</RootNamespace>
    <AssemblyName>RepoStudio</AssemblyName>
    <ApplicationTitle>Repo Studio</ApplicationTitle>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>Hybrid CLI + Avalonia multi-repo Git studio over Novolis.IO.Git and Novolis.Avalonia.Git.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Novolis.Avalonia.Git" />
    <PackageReference Include="Novolis.Avalonia.Studio" />
    <PackageReference Include="Novolis.IO.Git" />
  </ItemGroup>
</Project>
