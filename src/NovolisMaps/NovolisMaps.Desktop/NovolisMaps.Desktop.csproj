<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>NovolisMaps.Desktop</RootNamespace>
    <AssemblyName>NovolisMaps</AssemblyName>
    <ApplicationTitle>Novolis Maps</ApplicationTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NovolisMaps\NovolisMaps.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <LibraryReference Include="Novolis.Avalonia.Mobile.Desktop" />
    <LibraryReference Include="Novolis.Avalonia.GraphicalProfile" />
    <LibraryReference Include="Novolis.MSBuild.BuildReference" />
    <PackageReference Include="Novolis.Avalonia.Packaging.Inno" PrivateAssets="all" />
  </ItemGroup>
</Project>
