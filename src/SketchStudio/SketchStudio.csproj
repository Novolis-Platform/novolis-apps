<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SketchStudio</RootNamespace>
    <AssemblyName>SketchStudio</AssemblyName>
    <ApplicationTitle>Sketch Studio</ApplicationTitle>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>Freehand sketching studio — SketchControl with .sketchjson persistence and clipboard PNG/SVG export.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Novolis.Avalonia.Controls" />
    <PackageReference Include="Novolis.Avalonia.Packaging.Inno">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Optris.Icons.Avalonia" />
    <PackageReference Include="Optris.Icons.Avalonia.FontAwesome" />
  </ItemGroup>
</Project>
