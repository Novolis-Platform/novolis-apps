<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DraftStudio</RootNamespace>
    <AssemblyName>DraftStudio</AssemblyName>
    <ApplicationTitle>Draft Studio</ApplicationTitle>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Novolis.Avalonia.Packaging.Inno">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Novolis.Avalonia.Raylib" />
    <PackageReference Include="Novolis.Avalonia.Studio" />
    <PackageReference Include="Novolis.Commands.Expressions" />
    <PackageReference Include="Novolis.Math.Geometry" />
    <PackageReference Include="Novolis.Raylib" />
    <PackageReference Include="Novolis.Raylib.Bindings" />
    <PackageReference Include="Novolis.Raylib.Runtime" />
    <PackageReference Include="Novolis.Rendering.Presentation.Silk" />
  </ItemGroup>
</Project>
